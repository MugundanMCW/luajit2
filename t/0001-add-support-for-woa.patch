diff --git a/tensorflow/tools/toolchains/win2022/BUILD b/tensorflow/tools/toolchains/win2022/BUILD
index fd24f4ac62e..01199d583c5 100644
--- a/tensorflow/tools/toolchains/win2022/BUILD
+++ b/tensorflow/tools/toolchains/win2022/BUILD
@@ -58,3 +58,24 @@ platform(
         "cache-silo-key": "20260115",
     },
 )
+
+# Local platform for Windows ARM64 (WOA) native builds.
+platform(
+    name = "windows_ltsc2022_arm64",
+    constraint_values = [
+        "@platforms//cpu:arm64",
+        "@platforms//os:windows",
+        "@bazel_tools//tools/cpp:clang-cl",
+    ],
+)
+
+# Alias for rules that use the aarch64 CPU constraint spelling.
+platform(
+    name = "windows_ltsc2022_aarch64",
+    constraint_values = [
+        "@platforms//cpu:aarch64",
+        "@platforms//os:windows",
+        "@bazel_tools//tools/cpp:clang-cl",
+    ],
+)
+
