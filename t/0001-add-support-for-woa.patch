From b9c50f49a22cedf865f7720e5f6f9b54eeca0515 Mon Sep 17 00:00:00 2001
From: Muguqti <mselvana@qti.qualcomm.com>
Date: Thu, 9 Jul 2026 11:57:36 +0530
Subject: [PATCH] add support for woa

---
 .bazelrc                                      | 37 ++++++++++++++
 configure.py                                  |  8 ++++
 tensorflow/BUILD                              | 30 ++++++++++++
 .../tools/toolchains/win2022/20260322/BUILD   | 48 ++++++++++++-------
 tensorflow/tools/toolchains/win2022/BUILD     | 21 ++++++++
 third_party/xla/xla/tsl/BUILD                 | 26 +++++++++-
 6 files changed, 152 insertions(+), 18 deletions(-)

diff --git a/.bazelrc b/.bazelrc
index c3145bd8e3b..29b77282296 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -560,7 +560,27 @@ common:win_clang --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-
 common:win_clang --extra_execution_platforms=//tensorflow/tools/toolchains/win:x64_windows-clang-cl
 common:win_clang --host_platform=//tensorflow/tools/toolchains/win:x64_windows-clang-cl
 
+common:win_arm64_clang --config=win_clang_base
+common:win_arm64_clang --config=clang_local
+common:win_arm64_clang --cpu=arm64_windows
+common:win_arm64_clang --extra_toolchains=@local_config_cc//:cc-toolchain-arm64_windows-clang-cl
+common:win_arm64_clang --extra_execution_platforms=//tensorflow/tools/toolchains/win2022:windows_ltsc2022_arm64
+common:win_arm64_clang --host_platform=//tensorflow/tools/toolchains/win2022:windows_ltsc2022_arm64
+common:win_arm64_clang --platforms=//tensorflow/tools/toolchains/win2022:windows_ltsc2022_arm64
+common:win_arm64_clang --linkopt=/MACHINE:ARM64
+common:win_arm64_clang --host_linkopt=/MACHINE:ARM64
+common:win_arm64_clang --define=tensorflow_mkldnn_contraction_kernel=0
+common:win_arm64_clang --define=xnn_enable_avxvnniint8=false
+common:win_arm64_clang --define=xnn_enable_avx512fp16=false
+common:win_arm64_clang --define=no_nccl_support=true
+common:win_arm64_clang --repo_env=TF_NEED_CUDA=0
+common:win_arm64_clang --repo_env=TF_NEED_ROCM=0
+common:win_arm64_clang --action_env=CLANG_COMPILER_PATH="C:/Program Files/LLVM/bin/clang-cl.exe"
+common:win_arm64_clang --repo_env=CC="C:/Program Files/LLVM/bin/clang-cl.exe"
+common:win_arm64_clang --repo_env=BAZEL_COMPILER="C:/Program Files/LLVM/bin/clang-cl.exe"
+
 common:windows_x86_cpu_2022 --config=win_clang_base
+
 common:windows_x86_cpu_2022 --crosstool_top="//tensorflow/tools/toolchains/win2022/20241118:toolchain"
 common:windows_x86_cpu_2022 --extra_toolchains="//tensorflow/tools/toolchains/win2022/20241118:cc-toolchain-x64_windows-clang-cl"
 common:windows_x86_cpu_2022 --extra_execution_platforms="//tensorflow/tools/toolchains/win2022:windows_ltsc2022_clang"
@@ -863,7 +883,24 @@ common:release_cpu_windows --config=release_base
 common:release_cpu_windows --config=avx_win
 common:release_cpu_windows --define=no_tensorflow_py_deps=true
 
+# Native Windows ARM64 CPU build. Do not inherit release_cpu_windows because it
+# enables x86-only AVX flags.
+common:release_cpu_windows_arm64 --config=release_base
+common:release_cpu_windows_arm64 --config=win_arm64_clang
+common:release_cpu_windows_arm64 --define=no_tensorflow_py_deps=true
+common:release_cpu_windows_arm64 --define=with_xla_support=false
+common:release_cpu_windows_arm64 --deleted_packages=tensorflow/compiler/aot,tensorflow/compiler/jit
+
+# Minimal native Windows ARM64 CPU wheel build for bring-up.
+common:release_cpu_windows_arm64_minimal --config=release_cpu_windows_arm64
+common:release_cpu_windows_arm64_minimal --config=nogcp
+common:release_cpu_windows_arm64_minimal --config=nonccl
+common:release_cpu_windows_arm64_minimal --define=disable_tf_lite_py=true
+common:release_cpu_windows_arm64_minimal --define=with_tpu_support=false
+common:release_cpu_windows_arm64_minimal --deleted_packages=tensorflow/core/tpu,tensorflow/compiler/tf2tensorrt,tensorflow/lite,tensorflow/go,tensorflow/java
+
 # Exclude TFRT integration for anything but Linux.
+
 common:android --config=no_tfrt
 common:macos   --config=no_tfrt
 common:windows --config=no_tfrt
diff --git a/configure.py b/configure.py
index 6711ff9df60..afede42af84 100644
--- a/configure.py
+++ b/configure.py
@@ -78,6 +78,11 @@ def is_s390x():
   return platform.machine() == 's390x'
 
 
+def is_arm64():
+  machine = platform.machine().lower()
+  return machine in ('aarch64', 'arm64')
+
+
 def is_cygwin():
   return platform.system().startswith('CYGWIN_NT')
 
@@ -456,10 +461,13 @@ def set_cc_opt_flags(environ_cp):
   if is_ppc64le():
     # gcc on ppc64le does not support -march, use mcpu instead
     default_cc_opt_flags = '-mcpu=native'
+  elif is_windows() and is_arm64():
+    default_cc_opt_flags = '/O2'
   elif is_windows():
     default_cc_opt_flags = '/arch:AVX'
   else:
     # On all other platforms, no longer use `-march=native` as this can result
+
     # in instructions that are too modern being generated. Users that want
     # maximum performance should compile TF in their environment and can pass
     # `-march=native` there.
diff --git a/tensorflow/BUILD b/tensorflow/BUILD
index ab323b8d6be..37fb3453a10 100644
--- a/tensorflow/BUILD
+++ b/tensorflow/BUILD
@@ -428,8 +428,36 @@ config_setting(
     visibility = ["//visibility:public"],
 )
 
+config_setting(
+    name = "windows_aarch64",
+    constraint_values = [
+        "@platforms//cpu:aarch64",
+        "@platforms//os:windows",
+    ],
+    visibility = ["//visibility:public"],
+)
+
+config_setting(
+    name = "windows_arm64",
+    constraint_values = [
+        "@platforms//cpu:arm64",
+        "@platforms//os:windows",
+    ],
+    visibility = ["//visibility:public"],
+)
+
+selects.config_setting_group(
+    name = "windows_arm64_any",
+    match_any = [
+        ":windows_aarch64",
+        ":windows_arm64",
+    ],
+    visibility = ["//visibility:public"],
+)
+
 config_setting(
     name = "no_tensorflow_py_deps",
+
     define_values = {"no_tensorflow_py_deps": "true"},
     visibility = ["//visibility:public"],
 )
@@ -653,6 +681,7 @@ selects.config_setting_group(
     match_any = [
         "@platforms//cpu:aarch32",
         "@platforms//cpu:aarch64",
+        "@platforms//cpu:arm64",
         "@platforms//cpu:armv6-m",
         "@platforms//cpu:armv7",
         "@platforms//cpu:armv7-m",
@@ -661,6 +690,7 @@ selects.config_setting_group(
     ],
 )
 
+
 config_setting(
     name = "freebsd",
     constraint_values = [
diff --git a/tensorflow/tools/toolchains/win2022/20260322/BUILD b/tensorflow/tools/toolchains/win2022/20260322/BUILD
